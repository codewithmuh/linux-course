      "width": 731.12,
      "height": 198.0,
      "text": "ps aux | grep nginx      # find a process\ntop   /   htop           # live CPU & memory\nkill <pid>               # ask it to stop (15)\nkill -9 <pid>            # force kill (9)\nsleep 60 &  \u00b7  jobs  \u00b7  fg  \u00b7  bg   # job control",
