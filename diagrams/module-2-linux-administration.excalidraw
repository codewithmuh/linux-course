      "text": "chmod +x script.sh       # make executable\nchmod 644 config.yaml    # rw-r--r--\nchmod 600 ~/.ssh/id_ed25519  # lock a secret\nchown deploy:deploy app.log  # owner + group\nchmod g+s shared/        # SGID: inherit group",
