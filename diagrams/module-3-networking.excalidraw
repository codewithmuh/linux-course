      "x": 156,
      "y": 2690,
      "width": 775.76,
      "height": 198.0,
      "text": "ssh-keygen -t ed25519    # make a key pair\nssh-copy-id user@host    # install the public key\nssh host                 # (via ~/.ssh/config alias)\nscp file host:/tmp/      # copy up over SSH\nscp host:/var/log/x .    # copy down",
      "originalText": "ssh-keygen -t ed25519    # make a key pair\nssh-copy-id user@host    # install the public key\nssh host                 # (via ~/.ssh/config alias)\nscp file host:/tmp/      # copy up over SSH\nscp host:/var/log/x .    # copy down",
      "fontSize": 24,
      "fontFamily": 3,
