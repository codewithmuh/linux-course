      "x": 156,
      "y": 3620,
      "width": 701.36,
      "height": 237.6,
      "text": "sort | uniq -c | sort -rn   # rank by frequency\ncut -d: -f1 /etc/passwd     # grab a field\nawk -F: '{print $1}'        # fields + math\nawk '$3 >= 1000'            # filter rows\nsed 's/old/new/g' file      # find & replace\nsed -i ...                  # edit in place",
