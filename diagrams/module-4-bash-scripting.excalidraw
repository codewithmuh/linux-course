      "x": 156,
      "y": 1932,
      "width": 775.76,
      "height": 237.6,
      "text": "set -euo pipefail        # fail fast & safely\nbackup() { local src=\"$1\"; ...; }   # function\ntargets=(/etc /var/www)  \u00b7  \"${targets[@]}\"  # array\n$1 $@ $#                 # script arguments\necho $?                  # exit code of last cmd\ntrap cleanup EXIT        # always-runs cleanup",
